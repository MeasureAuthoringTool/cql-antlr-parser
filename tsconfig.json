{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": true,
    "sourceMap": true
  },

  "include": ["src", "generated"],
  "exclude": ["test", "**/*.test.ts"]

}
